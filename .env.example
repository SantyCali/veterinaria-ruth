# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). El .env NUNCA se sube al repo.
#
# Solo va la clave pública (anon / publishable). La service_role NUNCA va en la app.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
